# Server Port
PORT=3000

# Environment (development | production | test)
NODE_ENV=development

# Log Level (error | warn | info | http | verbose | debug | silly)
LOG_LEVEL=info

# Email (display name used in outgoing emails)
EMAIL_FROM=Sohnic <noreply@sohnic.com>

# Development SMTP (example)
# Use a sandbox provider like Mailtrap for local testing.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASS=smtp_pass

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=sohnic_user
DB_PASSWORD=sohnic_pass
DB_NAME=sohnic

# Database URL
DATABASE_URL=postgresql://sohnic_user:sohnic_pass@db:5432/sohnic