mixin summary(s)
  -
    var margin = s.revenue > 0
      ? ((s.grossProfit / s.revenue) * 100).toFixed(1)
      : '0.0';
  table(width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse; margin-bottom:16px;")
    tr
      td(style="border-bottom:1px solid #eee;") Revenue
      td(align="right" style="border-bottom:1px solid #eee;") #{fmt(s.revenue)}
    tr
      td(style="border-bottom:1px solid #eee;") Cost of goods sold
      td(align="right" style="border-bottom:1px solid #eee;") #{fmt(s.cogs)}
    tr
      td(style="border-bottom:1px solid #eee; font-weight:600;") Gross profit
      td(align="right" style=`border-bottom:1px solid #eee; font-weight:600; color:${s.grossProfit >= 0 ? '#2e7d32' : '#c62828'};`) #{fmt(s.grossProfit)}
    tr
      td(style="border-bottom:1px solid #eee;") Gross margin
      td(align="right" style="border-bottom:1px solid #eee;") #{margin}%
    tr
      td Procurement &amp; manufacturing spend
      td(align="right") #{fmt(s.expenses)}

mixin branchSection(r)
  h2(style="margin:32px 0 12px; font-size:20px; color:#f3a4e4;")= r.branch.name

  h3(style="margin:16px 0 8px; font-size:16px;") Summary
  +summary(r)

  h3(style="margin:16px 0 8px; font-size:16px;") Top products
  if r.topItems.length
    table(width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;")
      tr(style="background-color:#ffc6f3;")
        th(align="left") Product
        th(align="right") Qty
        th(align="right") Revenue
      each item in r.topItems
        tr
          td(style="border-bottom:1px solid #eee;")= item.name
          td(align="right" style="border-bottom:1px solid #eee;")= item.totalQty
          td(align="right" style="border-bottom:1px solid #eee;") #{fmt(item.totalRevenue)}
  else
    p(style="color:#777; font-size:14px;") No sales in this period.

  h3(style="margin:16px 0 8px; font-size:16px;") Sales by customer type
  if r.byCustomerType.length
    table(width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;")
      tr(style="background-color:#ffc6f3;")
        th(align="left") Type
        th(align="right") Orders
        th(align="right") Total
      each c in r.byCustomerType
        tr
          td(style="border-bottom:1px solid #eee;")= c.type
          td(align="right" style="border-bottom:1px solid #eee;")= c.count
          td(align="right" style="border-bottom:1px solid #eee;") #{fmt(c.total)}
  else
    p(style="color:#777; font-size:14px;") No sales in this period.

doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Sohnic report
  body(style="margin:0; padding:0; background-color:#ffffff; font-family: Arial, Helvetica, sans-serif; color:#000;")
    table(width="100%" cellpadding="0" cellspacing="0")
      tr
        td(align="center" style="padding:40px 16px;")
          table(width="640" cellpadding="0" cellspacing="0" style="border:1px solid #eee; border-radius:8px;")
            tr
              td(style="padding:32px;")

                h1(style="margin:0 0 8px; font-size:24px; color:#f3a4e4; font-weight:600;")
                  | Sohnic Report
                p(style="margin:0 0 24px; font-size:16px; color:#555;")= label

                if total
                  h2(style="margin:0 0 12px; font-size:20px; color:#f3a4e4;") Company total
                  +summary(total)

                  h3(style="margin:24px 0 8px; font-size:16px;") Branch comparison
                  table(width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;")
                    tr(style="background-color:#ffc6f3;")
                      th(align="left") Branch
                      th(align="right") Revenue
                      th(align="right") COGS
                      th(align="right") Gross profit
                      th(align="right") Spend
                    each r in reports
                      tr
                        td(style="border-bottom:1px solid #eee;")= r.branch.name
                        td(align="right" style="border-bottom:1px solid #eee;") #{fmt(r.revenue)}
                        td(align="right" style="border-bottom:1px solid #eee;") #{fmt(r.cogs)}
                        td(align="right" style=`border-bottom:1px solid #eee; color:${r.grossProfit >= 0 ? '#2e7d32' : '#c62828'};`) #{fmt(r.grossProfit)}
                        td(align="right" style="border-bottom:1px solid #eee;") #{fmt(r.expenses)}

                each r in reports
                  +branchSection(r)